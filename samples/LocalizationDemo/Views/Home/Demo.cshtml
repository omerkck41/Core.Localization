@using LocalizationDemo.Controllers
@model DemoViewModel
@{
    ViewData["Title"] = "Ecommerce Demo";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white text-center">
            <h3>@ViewBag.Welcome</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 border-right">
                    <h5 class="text-muted mb-4">Cart Status</h5>
                    <div class="alert alert-info">
                        <strong>@ViewBag.CartText</strong>
                    </div>
                    <div class="alert alert-warning">
                        <strong>@ViewBag.StockText</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5 class="text-muted mb-4">Order Summary</h5>
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> @ViewBag.OrderSuccessText
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-outline-primary btn-block">Continue Shopping</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-muted text-center">
            Powered by Core.Localization .NET 10.0
        </div>
    </div>

    <div class="mt-5 text-center">
        <a asp-action="Index" class="btn btn-secondary">Back to Main Page</a>
    </div>
</div>
